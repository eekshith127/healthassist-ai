# Application Settings
APP_NAME=HealthAssist
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=sqlite:///./healthassist.db
DIRECT_URL=
SUPABASE_URL=

# Security & Secrets
SECRET_KEY=healthassist-dev-secret-key-3928103981230

# Clerk Authentication (Backend-only)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# AI Global Flag (set to false to call live LLM APIs, fallback executes when offline)
MOCK_MODE=false

# AI Provider Roles
INTAKE_PROVIDER=gemini
ASSESSMENT_PROVIDER_1=nvidia
ASSESSMENT_PROVIDER_2=gemini
ASSESSMENT_PROVIDER_3=model3
JUDGE_PROVIDER=nvidia

# 1. Gemini (Conversational Intake AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 2. NVIDIA (Independent Assessment Model #1 - Meta Llama 3.1 70B Instruct)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 3. Ollama (Independent Assessment Model #2 - Ollama Runtime)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2

# 4. Third Model / Provider (Independent Assessment Model #3)
MODEL3_API_KEY=
MODEL3_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL3_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# 5. AI Judge (Reasoning Model)
JUDGE_API_KEY=
JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
JUDGE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
