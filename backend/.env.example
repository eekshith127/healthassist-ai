# Application Settings
APP_NAME=HealthAssist
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./healthassist.db

# Security & Secrets
SECRET_KEY=healthassist-super-secret-development-key-change-in-production

# Clerk Authentication (Backend-only, Never expose to frontend)
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# AI / External LLM API Keys (Backend-only, never exposed to frontend)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
