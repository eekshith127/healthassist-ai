# Application Settings
APP_NAME=HealthAssist
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./healthassist.db

# Security & Secrets (Replace with secure random key in production)
SECRET_KEY=healthassist-super-secret-development-key-change-in-production

# AI / External LLM API Keys (Backend-only, never exposed to frontend)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
